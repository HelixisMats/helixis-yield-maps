# Copy to .streamlit/secrets.toml for local testing,
# or paste into Streamlit Cloud -> App -> Settings -> Secrets.
# Never upload a real secrets.toml to GitHub.

[passwords]
# user name = "password"   (one line per user)
admin = "change-me-long-password"
partner_italia = "change-me-too"
partner_rwanda = "and-this-one"

[access]
# user name = list of countries the user may open.
# ["*"] = all countries. A user missing here sees no maps.
# Remove the whole [access] section to let everyone see every country.
admin = ["*"]
partner_italia = ["italy"]
partner_rwanda = ["rwanda"]
